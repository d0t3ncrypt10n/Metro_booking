# ==============================================================================
# CloudWatch Monitoring, Alarms & Dashboard — MetroGo Observability
# ==============================================================================
# This configuration defines the observability infrastructure for MetroGo backend:
# 1. CloudWatch Log Group (/metrogo/backend) with retention policy.
# 2. Metric filter extracting HTTP 5xx error counts from incoming backend logs.
# 3. CloudWatch Alarm triggering when 5xx error count exceeds 10 in 5 minutes.
# 4. Amazon SNS Topic and Email Subscription for operational alert notifications.
# 5. CloudWatch Dashboard visualizing API Requests, 5xx Error Rates, and Latency.
# Every line is documented so that a 4th-year student can explain each parameter.
# ==============================================================================

# ─── CloudWatch Log Group for Backend ─────────────────────────────────────────
# Creates a central log group in CloudWatch to aggregate container logs from EKS.
resource "aws_cloudwatch_log_group" "backend" {
  # Name of the log group formatted as /metrogo/backend
  name              = "/${var.project_name}/backend"
  # Retains application logs for 14 days before automatic deletion to optimize cost
  retention_in_days = 14
  # Resource tags to identify project ownership
  tags = {
    # Name tag matching the log group name in AWS Console
    Name = "/${var.project_name}/backend"
  }
}

# ─── CloudWatch Metric Filter for 5xx Errors ──────────────────────────────────
# Scans log entries in /metrogo/backend and publishes a custom CloudWatch metric
# whenever an HTTP 5xx internal server error is detected.
resource "aws_cloudwatch_log_metric_filter" "backend_5xx_errors" {
  # Unique name for this metric filter resource
  name           = "${var.project_name}-backend-5xx-errors"
  # Filter pattern searching for common HTTP 5xx status codes in backend log streams
  pattern        = "?500 ?502 ?503 ?504 ?505 ?\"5xx\""
  # Target CloudWatch log group to inspect for matching error patterns
  log_group_name = aws_cloudwatch_log_group.backend.name

  # Defines the custom metric published to CloudWatch when a pattern matches
  metric_transformation {
    # Name of the custom metric created in CloudWatch
    name          = "5xxErrorCount"
    # Custom CloudWatch namespace to group MetroGo backend metrics
    namespace     = "MetroGo/Backend"
    # Increments the metric by 1 for each matched log event
    value         = "1"
    # Default metric value when no error logs occur in the period
    default_value = "0"
  }
}

# ─── SNS Topic for Alarm Notifications ────────────────────────────────────────
# Creates an Amazon SNS topic that distributes alert notifications to subscribers.
resource "aws_sns_topic" "alarm_notifications" {
  # Unique name for the SNS alert topic
  name = "${var.project_name}-alarm-notifications"
  # Resource tags to identify project ownership
  tags = {
    # Name tag to identify this SNS topic in the AWS Console
    Name = "${var.project_name}-alarm-notifications"
  }
}

# ─── SNS Email Subscription ───────────────────────────────────────────────────
# Subscribes an email address to the SNS topic to receive instant alarm emails.
resource "aws_sns_topic_subscription" "email_alert" {
  # ARN of the SNS topic to attach this subscription to
  topic_arn = aws_sns_topic.alarm_notifications.arn
  # Protocol for delivering notifications (email sends human-readable message)
  protocol  = "email"
  # Destination email address where AWS will deliver alert messages
  endpoint  = var.alert_email
}

# ─── CloudWatch Metric Alarm for High 5xx Error Rate ──────────────────────────
# Evaluates 5xx error metrics and triggers an alarm if errors exceed 10 in 5 mins.
resource "aws_cloudwatch_metric_alarm" "high_5xx_errors" {
  # Human-readable identifier for the CloudWatch alarm
  alarm_name          = "${var.project_name}-high-5xx-error-rate"
  # Threshold operator: alarm triggers when metric is strictly greater than threshold
  comparison_operator = "GreaterThanThreshold"
  # Number of consecutive periods required to trigger alarm state
  evaluation_periods  = 1
  # The CloudWatch metric name generated by the metric filter above
  metric_name         = "5xxErrorCount"
  # The namespace containing our custom metric
  namespace           = "MetroGo/Backend"
  # Measurement time window in seconds (300 seconds equals 5 minutes)
  period              = 300
  # Statistical aggregation method applied across the 5-minute window
  statistic           = "Sum"
  # Threshold value: alarm triggers if sum of 5xx errors exceeds 10 in 5 minutes
  threshold           = 10
  # Human-readable description explaining the operational significance of the alarm
  alarm_description   = "Triggers when MetroGo backend logs more than 10 HTTP 5xx errors within 5 minutes"
  # List of action ARNs to notify when transitioning into ALARM state (sends SNS email)
  alarm_actions       = [aws_sns_topic.alarm_notifications.arn]
  # List of action ARNs to notify when recovering back to OK state (sends SNS email)
  ok_actions          = [aws_sns_topic.alarm_notifications.arn]
  # Missing data is treated as healthy (not breaching) when traffic is low
  treat_missing_data  = "notBreaching"
  # Resource tags to identify project ownership
  tags = {
    # Name tag to identify this alarm in the AWS Console
    Name = "${var.project_name}-high-5xx-error-rate"
  }
}

# ─── CloudWatch Dashboard ─────────────────────────────────────────────────────
# Creates an interactive CloudWatch monitoring dashboard with metrics widgets.
resource "aws_cloudwatch_dashboard" "backend_dashboard" {
  # Name of the dashboard displayed in the AWS CloudWatch console
  dashboard_name = "${var.project_name}-backend-dashboard"

  # JSON payload defining dashboard layout, widget placement, and metric queries
  dashboard_body = jsonencode({
    # Array of dashboard visual widgets arranged in a 24-column grid layout
    widgets = [
      # ── Widget 1: Backend API Requests ──
      {
        # Widget visual type: metric line chart
        type   = "metric"
        # Horizontal X coordinate position on 24-column grid
        x      = 0
        # Vertical Y coordinate position on dashboard canvas
        y      = 0
        # Width of widget occupying 8 columns (one-third of dashboard row)
        width  = 8
        # Height of widget in grid units
        height = 6
        # Configuration properties of the API Requests metric widget
        properties = {
          # Array of metric definitions: [Namespace, MetricName, DisplayProperties]
          metrics = [
            [
              "MetroGo/Backend",
              "APIRequests",
              { "stat" : "Sum", "label" : "Total API Requests", "color" : "#1f77b4" }
            ]
          ]
          # Metric aggregation period in seconds (300 seconds = 5 minutes)
          period = 300
          # Default statistic used for visualization
          stat   = "Sum"
          # AWS Region where metrics are collected and displayed
          region = var.aws_region
          # Title banner displayed at the top of this widget
          title  = "MetroGo Backend — API Request Volume"
          # View type: time series chart
          view   = "timeSeries"
        }
      },
      # ── Widget 2: 5xx Error Rate & Threshold ──
      {
        # Widget visual type: metric line chart
        type   = "metric"
        # Horizontal X coordinate position placed after widget 1 (column 8)
        x      = 8
        # Vertical Y coordinate position on dashboard canvas
        y      = 0
        # Width of widget occupying 8 columns (one-third of dashboard row)
        width  = 8
        # Height of widget in grid units
        height = 6
        # Configuration properties of the 5xx Error Rate metric widget
        properties = {
          # Array of metric definitions: [Namespace, MetricName, DisplayProperties]
          metrics = [
            [
              "MetroGo/Backend",
              "5xxErrorCount",
              { "stat" : "Sum", "label" : "HTTP 5xx Server Errors", "color" : "#d62728" }
            ]
          ]
          # Metric aggregation period in seconds (300 seconds = 5 minutes)
          period = 300
          # Default statistic used for visualization
          stat   = "Sum"
          # AWS Region where metrics are collected and displayed
          region = var.aws_region
          # Title banner displayed at the top of this widget
          title  = "MetroGo Backend — 5xx Error Rate"
          # View type: time series chart
          view   = "timeSeries"
          # Visual alarm threshold guide line drawn horizontally across chart
          annotations = {
            # Horizontal threshold line indicators
            horizontal = [
              {
                # Error count value where alarm triggers
                value = 10
                # Label explaining the significance of the threshold line
                label = "Alarm Threshold (>10 errors/5m)"
                # Color of the threshold line (warning red)
                color = "#d62728"
              }
            ]
          }
        }
      },
      # ── Widget 3: Backend Latency (Response Time) ──
      {
        # Widget visual type: metric line chart
        type   = "metric"
        # Horizontal X coordinate position placed after widget 2 (column 16)
        x      = 16
        # Vertical Y coordinate position on dashboard canvas
        y      = 0
        # Width of widget occupying 8 columns (one-third of dashboard row)
        width  = 8
        # Height of widget in grid units
        height = 6
        # Configuration properties of the Latency metric widget
        properties = {
          # Array of metric definitions: Average and 95th Percentile Latency
          metrics = [
            [
              "MetroGo/Backend",
              "Latency",
              { "stat" : "Average", "label" : "Average Latency (ms)", "color" : "#2ca02c" }
            ],
            [
              "MetroGo/Backend",
              "Latency",
              { "stat" : "p95", "label" : "p95 Latency (ms)", "color" : "#ff7f0e" }
            ]
          ]
          # Metric aggregation period in seconds (300 seconds = 5 minutes)
          period = 300
          # Default statistic used for visualization
          stat   = "Average"
          # AWS Region where metrics are collected and displayed
          region = var.aws_region
          # Title banner displayed at the top of this widget
          title  = "MetroGo Backend — Response Latency (ms)"
          # View type: time series chart
          view   = "timeSeries"
        }
      }
    ]
  })
}
