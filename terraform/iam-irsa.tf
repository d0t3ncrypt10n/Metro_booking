# ==============================================================================
# IAM Roles for Service Accounts (IRSA) — MetroGo Pod Security
# ==============================================================================
# This configuration creates the IAM infrastructure enabling EKS pods to securely
# assume AWS IAM roles using OpenID Connect (OIDC) identity federation:
# 1. AWS IAM OpenID Connect (OIDC) provider for the EKS cluster.
# 2. IAM Role for MetroGo backend service account with trust policy.
# 3. IAM Policy for reading Secrets Manager secrets & decrypting with KMS.
# 4. IAM Policy for writing application logs to CloudWatch Log Group.
# 5. Policy attachments linking both policies to the IRSA role.
# 6. Kubernetes ServiceAccount annotation configuration for deployment manifests.
# Every line is documented so that a 4th-year student can explain each parameter.
# ==============================================================================

# ─── EKS OIDC Identity Provider ───────────────────────────────────────────────
# Establishes trust between AWS IAM and the Kubernetes cluster's OIDC issuer.
# This enables Kubernetes service accounts to exchange pod tokens for AWS STS credentials.
resource "aws_iam_openid_connect_provider" "eks_irsa" {
  # List of allowed client IDs; STS service is required for assume role operations
  client_id_list  = ["sts.amazonaws.com"]
  # Secure SHA-1 root certificate thumbprint for the EKS OIDC server
  thumbprint_list = ["9e99a48a9960b14926bb7f3b02e22da2b0ab7280"]
  # The OIDC issuer URL generated by AWS EKS during cluster creation
  url             = aws_eks_cluster.main.identity[0].oidc[0].issuer
}

# ─── IAM Role for Backend Pods (IRSA) ─────────────────────────────────────────
# Defines the IAM role that the MetroGo backend Kubernetes pods will assume.
resource "aws_iam_role" "backend_irsa" {
  # Name of the IAM role matching the naming convention used in Kubernetes manifests
  name        = "${var.project_name}-backend-irsa-role"
  # Clear description explaining the purpose of this IAM role for evaluators
  description = "IAM role assumed by MetroGo backend pods in EKS via IRSA"

  # Trust policy specifying who can assume this IAM role (OIDC Web Identity)
  assume_role_policy = jsonencode({
    # Policy language version specification
    Version   = "2012-10-17"
    # List of policy statements defining authorization rules
    Statement = [
      {
        # Action allowing federation via OpenID Connect web identity tokens
        Action    = "sts:AssumeRoleWithWebIdentity"
        # Grants permission to perform the assume role action
        Effect    = "Allow"
        # The trusted identity provider permitted to authenticate the caller
        Principal = {
          # ARN of our EKS OIDC identity provider defined above
          Federated = aws_iam_openid_connect_provider.eks_irsa.arn
        }
        # Conditions enforcing that only our specific Kubernetes service account can assume this role
        Condition = {
          # StringEquals condition check for exact value matching
          StringEquals = {
            # Matches the Kubernetes ServiceAccount subject identifier (namespace:serviceaccount)
            "${replace(aws_iam_openid_connect_provider.eks_irsa.url, "https://", "")}:sub" = [
              # Restricts assumption strictly to backend service account in metrogo namespace
              "system:serviceaccount:metrogo:metrogo-backend-sa",
              # Allows assumption in default namespace for fallback local testing
              "system:serviceaccount:default:metrogo-backend-sa"
            ]
            # Validates that the token audience matches the AWS STS service endpoint
            "${replace(aws_iam_openid_connect_provider.eks_irsa.url, "https://", "")}:aud" = "sts.amazonaws.com"
          }
        }
      }
    ]
  })

  # Resource tags to identify project ownership
  tags = {
    # Name tag to identify this IAM role in the AWS Console
    Name = "${var.project_name}-backend-irsa-role"
  }
}

# ─── IAM Policy: Secrets Manager Read & KMS Decrypt ───────────────────────────
# Defines least-privilege permissions allowing backend pods to retrieve secrets.
resource "aws_iam_policy" "secrets_manager_read" {
  # Name of the Secrets Manager read policy
  name        = "${var.project_name}-secrets-read-policy"
  # Description of the policy permissions for evaluators
  description = "Allows MetroGo backend pods to read secrets and decrypt them with KMS"

  # JSON policy document granting read-only access to required secrets and KMS key
  policy = jsonencode({
    # Policy language version specification
    Version   = "2012-10-17"
    # List of permission statements
    Statement = [
      # Statement 1: Read secret values and metadata from AWS Secrets Manager
      {
        # Grants permission for specified actions
        Effect   = "Allow"
        # Specific Secrets Manager read operations permitted
        Action   = [
          # Allows retrieving the decrypted secret string value
          "secretsmanager:GetSecretValue",
          # Allows inspecting secret metadata such as tags and rotation status
          "secretsmanager:DescribeSecret"
        ]
        # Scope permissions strictly to our project's three application secrets
        Resource = [
          # ARN of the Twilio credentials secret
          aws_secretsmanager_secret.twilio.arn,
          # ARN of the JWT signing key secret
          aws_secretsmanager_secret.jwt.arn,
          # ARN of the MongoDB database URI secret
          aws_secretsmanager_secret.mongodb.arn
        ]
      },
      # Statement 2: Decrypt secret values using Customer Managed KMS Key
      {
        # Grants permission for specified KMS action
        Effect   = "Allow"
        # Allows cryptographic decryption of cipher text
        Action   = [
          # Required to decrypt secrets encrypted with our customer managed KMS key
          "kms:Decrypt"
        ]
        # Restricts KMS decryption strictly to our MetroGo secrets KMS key
        Resource = [
          # ARN of the KMS key created in secrets-manager.tf
          aws_kms_key.secrets.arn
        ]
      }
    ]
  })
}

# ─── Attach Secrets Manager Read Policy to IRSA Role ──────────────────────────
# Attaches the secrets read policy to the backend pod IAM role.
resource "aws_iam_role_policy_attachment" "backend_secrets_read" {
  # Name of the IAM role receiving the policy
  role       = aws_iam_role.backend_irsa.name
  # ARN of the policy granting Secrets Manager read access
  policy_arn = aws_iam_policy.secrets_manager_read.arn
}

# ─── IAM Policy: CloudWatch Logs Write ────────────────────────────────────────
# Defines least-privilege permissions allowing backend pods to send logs to CloudWatch.
resource "aws_iam_policy" "cloudwatch_logs_write" {
  # Name of the CloudWatch logs write policy
  name        = "${var.project_name}-cloudwatch-logs-policy"
  # Description of the policy permissions for evaluators
  description = "Allows MetroGo backend pods to create log streams and write events to CloudWatch"

  # JSON policy document granting log streaming permissions
  policy = jsonencode({
    # Policy language version specification
    Version   = "2012-10-17"
    # List of permission statements
    Statement = [
      {
        # Grants permission for specified log actions
        Effect   = "Allow"
        # Specific CloudWatch Logs operations required by application loggers
        Action   = [
          # Allows creating a new log stream inside the log group
          "logs:CreateLogStream",
          # Allows uploading batch log events to the log stream
          "logs:PutLogEvents",
          # Allows querying log stream names and existence
          "logs:DescribeLogStreams"
        ]
        # Scope permissions strictly to our backend application log group
        Resource = [
          # ARN of the /metrogo/backend log group created in cloudwatch.tf
          aws_cloudwatch_log_group.backend.arn,
          # Wildcard ARN covering all log streams within the log group
          "${aws_cloudwatch_log_group.backend.arn}:*"
        ]
      }
    ]
  })
}

# ─── Attach CloudWatch Logs Write Policy to IRSA Role ─────────────────────────
# Attaches the CloudWatch logs write policy to the backend pod IAM role.
resource "aws_iam_role_policy_attachment" "backend_cloudwatch_logs" {
  # Name of the IAM role receiving the policy
  role       = aws_iam_role.backend_irsa.name
  # ARN of the policy granting CloudWatch logs write access
  policy_arn = aws_iam_policy.cloudwatch_logs_write.arn
}

# ─── Kubernetes Service Account Annotation Configuration ──────────────────────
# Defines the exact annotation key and IAM Role ARN value required in Kubernetes
# ServiceAccount manifests to link the pod identity to this AWS IAM role.
locals {
  # Map holding Kubernetes ServiceAccount annotation metadata
  k8s_service_account_annotation = {
    # Standard AWS EKS annotation key mapping the ServiceAccount to this IAM role ARN
    "eks.amazonaws.com/role-arn" = aws_iam_role.backend_irsa.arn
  }
}
